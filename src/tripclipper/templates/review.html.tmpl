<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self' file: data:; img-src 'self' file: data:; media-src 'self' file: data: blob:; script-src 'unsafe-inline'; style-src 'unsafe-inline'">
<title>TripClipper Review</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif; margin: 0; padding: 16px; color: #222; background: #fafafa; }
  h1 { font-size: 18px; margin: 0 0 12px 0; }
  h2 { font-size: 14px; margin: 12px 0 6px 0; color: #555; }
  .header { background: #fff; border: 1px solid #e0e0e0; border-radius: 6px; padding: 12px 16px; margin-bottom: 12px; }
  .header dl { display: grid; grid-template-columns: 140px 1fr; gap: 4px 12px; margin: 0; font-size: 12px; }
  .header dt { color: #888; }
  .header dd { margin: 0; word-break: break-all; }
  .header .failures { background: #fff7f7; border-left: 3px solid #d04848; padding: 6px 10px; margin-top: 8px; font-size: 12px; }
  .header .notice { background: #fff8e1; border-left: 3px solid #d4a017; padding: 6px 10px; margin-top: 8px; font-size: 12px; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; align-items: center; }
  .controls input, .controls select { font-size: 12px; padding: 4px 8px; border: 1px solid #ccc; border-radius: 4px; background: #fff; }
  .controls input { min-width: 220px; }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; min-width: 1720px; border-collapse: collapse; background: #fff; font-size: 12px; }
  th, td { border: 1px solid #e0e0e0; padding: 5px 6px; text-align: left; vertical-align: top; }
  th { background: #f0f0f0; user-select: none; position: sticky; top: 0; z-index: 1; }
  tr.row-pending { background: #fffbe6; }
  tr.row-failed { background: #fff1f0; }
  tr:hover { background: #f5f9ff !important; cursor: pointer; }
  td.thumb-cell { width: 132px; min-width: 132px; }
  td.thumb-cell .thumb-strip { display: grid; grid-template-columns: repeat(3, 40px); gap: 3px; align-items: start; }
  td.thumb-cell .thumb-strip img { width: 40px; height: 40px; display: block; object-fit: cover; border-radius: 3px; }
  td.thumb-cell img { width: 40px; height: 40px; display: block; object-fit: cover; border-radius: 3px; }
  .thumb-overflow { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; background: #eef3fa; color: #2a5db0; border-radius: 3px; font-size: 11px; font-weight: 600; }
  .no-thumb { display: inline-block; padding: 20px 10px; background: #ddd; color: #777; font-size: 11px; border-radius: 3px; text-align: center; }
  .status-analyzed { color: #2a8a2a; font-weight: 600; }
  .status-scanned { color: #c08010; font-weight: 600; }
  .status-failed { color: #c03030; font-weight: 600; }
  .status-other { color: #888; }
  .stars { color: #f5a623; letter-spacing: 1px; }
  .segment { color: #555; font-family: SFMono-Regular, Consolas, monospace; font-size: 11px; }
  .speech-cell { min-width: 280px; max-width: 420px; line-height: 1.45; }
  .speech-quality { display: inline-block; padding: 1px 7px; border-radius: 10px; font-weight: 600; margin-bottom: 3px; }
  .speech-clear { background: #e8f5e9; color: #237a28; }
  .speech-unclear { background: #fff3e0; color: #a65d00; }
  .speech-none { background: #f0f1f3; color: #666; }
  .speech-pending { background: #fff8e1; color: #9a6a00; }
  .speech-segment { margin-top: 3px; border-top: 1px dashed #ddd; padding-top: 3px; }
  .speech-time { color: #2a5db0; font-family: SFMono-Regular, Consolas, monospace; font-size: 11px; }
  .transcript-error { color: #c03030; font-size: 11px; }
  .tags-cell { min-width: 220px; max-width: 320px; overflow-wrap: anywhere; word-break: normal; }
  .summary-cell { min-width: 360px; max-width: 520px; overflow-wrap: anywhere; word-break: normal; line-height: 1.45; }
  .summary-cell .scan-info { color: #c08010; font-weight: 600; display: inline-block; margin-bottom: 2px; }
  .filename-cell { width: 200px; max-width: 240px; font-family: SFMono-Regular, Consolas, monospace; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .filename-cell .eagle-target-name { display: block; margin-top: 3px; color: #687386; white-space: normal; overflow-wrap: anywhere; }
  td.media-cell { font-size: 11px; line-height: 1.5; min-width: 140px; }
  td.media-cell .media-line { display: inline-block; }
  td.media-cell .media-line:first-child { font-weight: 600; color: #333; }
  td.media-cell .media-line + .media-line { color: #777; }
  .similar-groups { margin: 8px 0 12px; }
  .similar-groups-panel, .session-card { background: #fff; border: 1px solid #d0d7e2; border-radius: 8px; margin-bottom: 10px; overflow: hidden; }
  .similar-groups-summary, .group-card-summary, .session-card-summary { list-style: none; cursor: pointer; }
  .similar-groups-summary::-webkit-details-marker,
  .group-card-summary::-webkit-details-marker,
  .session-card-summary::-webkit-details-marker { display: none; }
  .similar-groups-summary { padding: 10px 14px; background: #f5f9ff; color: #24446f; font-size: 13px; font-weight: 600; }
  .similar-groups-body { padding: 10px; background: #fbfcfe; }
  .group-card { background: #fff; border: 1px solid #d0d7e2; border-radius: 6px; margin-bottom: 8px; }
  .group-card-summary { padding: 8px 12px; background: #fff; }
  .group-card h3 { font-size: 13px; margin: 0; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .basis-chip { display: inline-block; background: #eef3fa; color: #2a5db0; padding: 1px 8px; border-radius: 10px; font-size: 11px; font-weight: normal; }
  .chip-warn { background: #fff3e0; color: #c47200; padding: 1px 8px; border-radius: 10px; font-size: 11px; }
  .members { list-style: none; padding: 0 12px 10px; margin: 0; }
  .members li { display: grid; grid-template-columns: 92px 1fr auto auto; gap: 10px; align-items: center; padding: 4px 0; border-top: 1px dashed #eee; cursor: pointer; }
  .members li:first-child { border-top: none; }
  .members li:hover { background: #f5f9ff; }
  .group-thumb { width: 92px; max-height: 58px; object-fit: cover; border-radius: 3px; }
  .no-thumb-mini { width: 92px; height: 54px; background: #eee; display: flex; align-items: center; justify-content: center; color: #888; font-size: 18px; border-radius: 3px; }
  .muted { color: #888; font-size: 11px; }
  .sel-primary { color: #2a8a2a; font-weight: 600; }
  .sel-alternate { color: #1e60c2; }
  .sel-rejected { color: #888; }
  .sel-needs-review { color: #c47200; }
  .cand-default { color: #2a8a2a; font-weight: 600; }
  .cand-alternate { color: #1e60c2; }
  .cand-excluded { color: #888; }
  .cand-needs-review { color: #c47200; }
  tr.same-group-hover { background: #eaf3ff !important; }
  tr.flash { animation: flash 1.5s ease-out; }
  @keyframes flash { 0% { background: #fff3a8; } 100% { background: transparent; } }
  .drawer { display: none; background: #f4f7fc; border: 1px solid #c8d4e8; padding: 12px; border-radius: 4px; margin: 6px 0; }
  .drawer.open { display: block; }
  .drawer pre { white-space: pre-wrap; word-break: break-all; font-size: 11px; max-height: 320px; overflow: auto; background: #fff; padding: 8px; border-radius: 3px; margin: 4px 0; }
  .drawer .frame-grid { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .drawer .frame-grid img { width: 160px; max-height: 100px; object-fit: cover; border-radius: 3px; border: 1px solid #ccc; }
  .overview { margin: 6px 0 10px; padding: 8px 12px; background: #f5f9ff; border-left: 3px solid #2a5db0; border-radius: 3px; }
  .overview-row { font-size: 13px; line-height: 1.7; color: #2b3340; }
  .overview-row + .overview-row { margin-top: 2px; }
  td.thumb-cell .thumb-strip img,
  td.thumb-cell > img,
  .group-thumb { cursor: zoom-in; }
  .video-open-btn { display: inline-block; margin-top: 6px; padding: 3px 10px; background: #2a5db0; color: #fff; font-size: 11px; border-radius: 3px; text-decoration: none; cursor: pointer; }
  .video-open-btn:hover { background: #1e4a90; }
  .lightbox-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.92); z-index: 9999; align-items: center; justify-content: center; flex-direction: column; }
  .lightbox-overlay.open { display: flex; }
  .lightbox-content { max-width: 95vw; max-height: 80vh; display: flex; align-items: center; justify-content: center; }
  .lightbox-content img, .lightbox-content video { max-width: 95vw; max-height: 80vh; display: block; object-fit: contain; background: #000; }
  .lightbox-close { position: fixed; top: 16px; right: 24px; color: #fff; font-size: 28px; cursor: pointer; user-select: none; background: rgba(0,0,0,0.5); border-radius: 50%; width: 40px; height: 40px; line-height: 40px; text-align: center; z-index: 10000; }
  .lightbox-nav { position: fixed; top: 50%; transform: translateY(-50%); color: #fff; font-size: 36px; cursor: pointer; user-select: none; background: rgba(0,0,0,0.45); padding: 6px 14px; border-radius: 4px; z-index: 10000; }
  .lightbox-prev { left: 24px; }
  .lightbox-next { right: 24px; }
  .lightbox-toolbar { margin-top: 12px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; justify-content: center; }
  .lightbox-toolbar a, .lightbox-toolbar button { background: #2a5db0; color: #fff; padding: 6px 14px; border-radius: 3px; text-decoration: none; cursor: pointer; border: none; font-size: 13px; }
  .lightbox-toolbar a:hover, .lightbox-toolbar button:hover { background: #1e4a90; }
  .lightbox-caption { color: #ccc; font-size: 12px; max-width: 95vw; text-align: center; margin-top: 8px; }
  .sessions-view { margin-top: 10px; }
  .session-card-summary { padding: 10px 14px; background: #f7f9fc; color: #24324a; font-size: 13px; font-weight: 600; }
  .session-card-body { padding: 10px; background: #fff; }
  .session-card-unknown .session-card-summary { color: #6c7480; background: #f1f2f4; }
  .session-card-ungrouped .session-card-summary { background: #f8fafc; }
  /* session badges (flat table session column) */
  .session-badge { display: inline-block; background: #eef3fa; color: #2a5db0; padding: 1px 8px; border-radius: 10px; font-size: 11px; }
  .session-badge.session-unknown { background: #eee; color: #888; }
</style>
</head>
<body>
<h1>TripClipper · review.html</h1>
__PROJECT_HEADER_HTML__
__SIMILAR_GROUPS_HTML__

<div class="controls">
  <input id="search" type="text" placeholder="搜索 filename / summary / tags ...">
  <select id="filter-subject-type"><option value="">subject_type: 全部</option></select>
  <select id="filter-shot-scale"><option value="">shot_scale: 全部</option></select>
  <select id="filter-status"><option value="">analysis_status: 全部</option></select>
  <select id="filter-speech-quality"><option value="">speech_quality: 全部</option></select>
  <select id="filter-similar">
    <option value="">相似组: 全部</option>
    <option value="in-group">仅相似组成员</option>
    <option value="not-in-group">仅非相似组</option>
  </select>
  <select id="filter-candidate">
    <option value="">候选池: 全部</option>
    <option value="default_selected">default_selected</option>
    <option value="alternate">alternate</option>
    <option value="excluded">excluded</option>
    <option value="needs_review">needs_review</option>
  </select>
  <select id="filter-session"><option value="">session: 全部</option></select>
  <span id="row-count" style="color:#888; font-size:12px;"></span>
</div>

__SESSIONS_HTML__

<script id="cut-index-json" type="application/json">__JSON_DATA__</script>

<div id="lightbox" class="lightbox-overlay" role="dialog" aria-modal="true">
  <span class="lightbox-close" id="lightbox-close" title="关闭 (Esc)">×</span>
  <span class="lightbox-nav lightbox-prev" id="lightbox-prev" title="上一张 (←)">‹</span>
  <span class="lightbox-nav lightbox-next" id="lightbox-next" title="下一张 (→)">›</span>
  <div class="lightbox-content" id="lightbox-content"></div>
  <div class="lightbox-toolbar" id="lightbox-toolbar"></div>
  <div class="lightbox-caption" id="lightbox-caption"></div>
</div>
<script>
(function(){
  var raw = document.getElementById('cut-index-json').textContent || '{}';
  var data = JSON.parse(raw);
  window.__CUT_INDEX_DATA__ = data;
  var assetsById = {};
  (data.assets || []).forEach(function(a){ if (a.asset_id) assetsById[a.asset_id] = a; });

  var rows = Array.prototype.slice.call(document.querySelectorAll('tr.asset-row'));
  var sessionCards = Array.prototype.slice.call(document.querySelectorAll('.session-card'));

  function pad2(n){ return n < 10 ? '0' + n : '' + n; }

  function formatLocalDateTime(value){
    if (!value) return '';
    var d = new Date(value);
    if (isNaN(d.getTime())) return String(value).replace('T', ' ').slice(0, 16);
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()) + ' ' + pad2(d.getHours()) + ':' + pad2(d.getMinutes());
  }

  function formatSessionOptionLabel(session){
    var sid = session.session_id || '';
    if (!sid) return '';
    var start = formatLocalDateTime(session.started_at);
    var end = formatLocalDateTime(session.ended_at);
    var label = sid;
    if (start && end){
      label += ' · ' + start + ' → ' + end.slice(11, 16);
    } else if (start || end) {
      label += ' · ' + (start || end);
    } else if (sid === 'session_00_unknown') {
      label += ' · 时间信息缺失';
    }
    var count = session.asset_count || (session.asset_ids || []).length;
    if (count) label += ' · ' + count + ' 张';
    return label;
  }

  var sessionLabelsById = {};
  (data.sessions || []).forEach(function(s){
    var sid = s.session_id || '';
    if (sid) sessionLabelsById[sid] = formatSessionOptionLabel(s);
  });

  function fillFilterOptions(selectId, attr, labelsByValue){
    var sel = document.getElementById(selectId);
    if (!sel) return;
    var seen = {};
    var values = [];
    rows.forEach(function(r){
      var v = r.getAttribute(attr) || '';
      if (v && !seen[v]){ seen[v] = true; values.push(v); }
    });
    values.sort();
    values.forEach(function(v){
      var o = document.createElement('option'); o.value = v; o.textContent = (labelsByValue && labelsByValue[v]) || v; sel.appendChild(o);
    });
  }
  fillFilterOptions('filter-subject-type', 'data-subject-type');
  fillFilterOptions('filter-shot-scale', 'data-shot-scale');
  fillFilterOptions('filter-status', 'data-status');
  fillFilterOptions('filter-speech-quality', 'data-speech-quality');
  fillFilterOptions('filter-session', 'data-session-id', sessionLabelsById);

  function currentFilters(){
    return {
      q: (document.getElementById('search').value || '').toLowerCase().trim(),
      fst: document.getElementById('filter-subject-type').value,
      fss: document.getElementById('filter-shot-scale').value,
      fst2: document.getElementById('filter-status').value,
      fspeech: document.getElementById('filter-speech-quality').value,
      fsim: document.getElementById('filter-similar').value,
      fcand: document.getElementById('filter-candidate').value,
      fsession: document.getElementById('filter-session').value
    };
  }

  function rowMatches(r, f){
    if (f.q){
      var hay = ((r.getAttribute('data-search') || '') + '').toLowerCase();
      if (hay.indexOf(f.q) === -1) return false;
    }
    if (f.fst && r.getAttribute('data-subject-type') !== f.fst) return false;
    if (f.fss && r.getAttribute('data-shot-scale') !== f.fss) return false;
    if (f.fst2 && r.getAttribute('data-status') !== f.fst2) return false;
    if (f.fspeech && r.getAttribute('data-speech-quality') !== f.fspeech) return false;
    if (f.fsim){
      var gid = r.getAttribute('data-similar-group-id') || '';
      if (f.fsim === 'in-group' && !gid) return false;
      if (f.fsim === 'not-in-group' && gid) return false;
    }
    if (f.fcand && r.getAttribute('data-edit-candidate-status') !== f.fcand) return false;
    if (f.fsession && (r.getAttribute('data-session-id') || '') !== f.fsession) return false;
    return true;
  }

  function applyFilters(){
    var f = currentFilters();
    var visible = 0;
    rows.forEach(function(r){
      var match = rowMatches(r, f);
      var drawer = r.nextElementSibling;
      if (match){
        r.style.display = '';
        visible += 1;
      } else {
        r.style.display = 'none';
        if (drawer && drawer.classList && drawer.classList.contains('drawer-row')) drawer.style.display = 'none';
      }
    });
    sessionCards.forEach(function(card){
      var cardRows = Array.prototype.slice.call(card.querySelectorAll('tr.asset-row'));
      var hasVisible = cardRows.some(function(r){ return r.style.display !== 'none'; });
      card.style.display = hasVisible ? '' : 'none';
    });
    document.getElementById('row-count').textContent = '显示 ' + visible + ' / ' + rows.length;
  }

  ['search', 'filter-subject-type', 'filter-shot-scale', 'filter-status', 'filter-similar', 'filter-candidate', 'filter-session'].forEach(function(id){
    var el = document.getElementById(id);
    if (!el) return;
    el.addEventListener(id === 'search' ? 'input' : 'change', applyFilters);
  });

  // drawer
  rows.forEach(function(r){
    r.addEventListener('click', function(e){
      if (e.target && e.target.closest && e.target.closest('.no-drawer')) return;
      var aid = r.getAttribute('data-asset-id');
      var existing = r.nextElementSibling;
      if (existing && existing.classList && existing.classList.contains('drawer-row')){
        existing.parentNode.removeChild(existing);
        return;
      }
      var asset = assetsById[aid] || {};
      var dr = document.createElement('tr');
      dr.className = 'drawer-row';
      var td = document.createElement('td');
      td.colSpan = r.children.length;
      var div = document.createElement('div');
      div.className = 'drawer open';
      if (asset.path && (asset.type === 'video' || /\.(mp4|mov|m4v|mkv|webm|avi)$/i.test(asset.path))){
        var openBar = document.createElement('div');
        openBar.style.marginBottom = '8px';
        var openLink = document.createElement('a');
        openLink.className = 'video-open-btn no-drawer';
        openLink.href = 'file://' + asset.path;
        openLink.target = '_blank';
        openLink.rel = 'noopener';
        openLink.textContent = '▶ 打开视频';
        openLink.addEventListener('click', function(ev){ ev.stopPropagation(); });
        openBar.appendChild(openLink);
        var playInline = document.createElement('button');
        playInline.className = 'video-open-btn no-drawer';
        playInline.style.marginLeft = '8px';
        playInline.style.border = 'none';
        playInline.textContent = '在弹窗中播放';
        playInline.addEventListener('click', function(ev){ ev.stopPropagation(); openLightboxVideo(asset.path, asset.filename || asset.relative_path || asset.path); });
        openBar.appendChild(playInline);
        div.appendChild(openBar);
      }
      var meta = document.createElement('pre');
      meta.textContent = JSON.stringify({
        path: asset.path, relative_path: asset.relative_path, type: asset.type,
        size: asset.size, modified_time: asset.modified_time, metadata: asset.metadata || {},
        thumbnail_path: asset.thumbnail_path, frame_paths: asset.frame_paths || [],
        frame_timestamps: asset.frame_timestamps || [],
        clip_suggestions: asset.clip_suggestions || [], failures: asset.failures || [],
        warnings: asset.warnings || []
      }, null, 2);
      div.appendChild(meta);
      var frames = asset.frame_paths || [];
      if (frames.length){
        var grid = document.createElement('div'); grid.className = 'frame-grid';
        frames.forEach(function(fp, fi){
          var img = document.createElement('img'); img.src = 'file://' + fp; img.alt = fp;
          img.style.cursor = 'zoom-in';
          img.className = 'no-drawer';
          img.addEventListener('click', function(ev){ ev.stopPropagation(); openLightboxFrames(frames, fi, asset); });
          img.onerror = function(){ img.style.display = 'none'; };
          grid.appendChild(img);
        });
        div.appendChild(grid);
      }
      td.appendChild(div);
      dr.appendChild(td);
      r.parentNode.insertBefore(dr, r.nextSibling);
    });
  });

  // group card member click → scroll + flash on the matching row
  document.querySelectorAll('.members li').forEach(function(li){
    li.addEventListener('click', function(){
      var aid = li.getAttribute('data-asset-id');
      if (!aid) return;
      var tr = document.querySelector('tr.asset-row[data-asset-id="' + aid + '"]');
      if (!tr) return;
      var sessionCard = tr.closest('.session-card');
      if (sessionCard && !sessionCard.hasAttribute('open')) sessionCard.setAttribute('open', '');
      tr.scrollIntoView({behavior: 'smooth', block: 'center'});
      tr.classList.add('flash');
      setTimeout(function(){ tr.classList.remove('flash'); }, 1500);
    });
  });

  // row hover → highlight same-group rows
  rows.forEach(function(r){
    var gid = r.getAttribute('data-similar-group-id') || '';
    if (!gid) return;
    r.addEventListener('mouseenter', function(){
      rows.forEach(function(other){
        if (other !== r && other.getAttribute('data-similar-group-id') === gid){
          other.classList.add('same-group-hover');
        }
      });
    });
    r.addEventListener('mouseleave', function(){
      rows.forEach(function(other){ other.classList.remove('same-group-hover'); });
    });
  });

  // --- Lightbox: thumbnail → big image; "open video" → file:// or inline <video> ---
  var lb = document.getElementById('lightbox');
  var lbContent = document.getElementById('lightbox-content');
  var lbToolbar = document.getElementById('lightbox-toolbar');
  var lbCaption = document.getElementById('lightbox-caption');
  var lbClose = document.getElementById('lightbox-close');
  var lbPrev = document.getElementById('lightbox-prev');
  var lbNext = document.getElementById('lightbox-next');
  var lbState = { frames: [], idx: 0, asset: null, mode: 'image' };

  function renderLightbox(){
    lbContent.innerHTML = '';
    lbToolbar.innerHTML = '';
    if (lbState.mode === 'video'){
      var vid = document.createElement('video');
      vid.src = 'file://' + lbState.videoPath;
      vid.controls = true;
      vid.autoplay = true;
      vid.style.maxWidth = '95vw';
      vid.style.maxHeight = '80vh';
      lbContent.appendChild(vid);
      lbPrev.style.display = 'none';
      lbNext.style.display = 'none';
      var openExt = document.createElement('a');
      openExt.href = 'file://' + lbState.videoPath;
      openExt.target = '_blank';
      openExt.rel = 'noopener';
      openExt.textContent = '在外部播放器中打开';
      lbToolbar.appendChild(openExt);
      lbCaption.textContent = lbState.caption || '';
    } else {
      var fp = lbState.frames[lbState.idx];
      var img = document.createElement('img');
      img.src = 'file://' + fp;
      img.alt = fp;
      lbContent.appendChild(img);
      var multi = lbState.frames.length > 1;
      lbPrev.style.display = multi ? '' : 'none';
      lbNext.style.display = multi ? '' : 'none';
      var asset = lbState.asset || {};
      if (asset.path && (asset.type === 'video' || /\.(mp4|mov|m4v|mkv|webm|avi)$/i.test(asset.path))){
        var openVid = document.createElement('a');
        openVid.href = 'file://' + asset.path;
        openVid.target = '_blank';
        openVid.rel = 'noopener';
        openVid.textContent = '▶ 打开视频';
        lbToolbar.appendChild(openVid);
        var playInline = document.createElement('button');
        playInline.textContent = '在弹窗中播放视频';
        playInline.addEventListener('click', function(){ openLightboxVideo(asset.path, asset.filename || asset.path); });
        lbToolbar.appendChild(playInline);
      }
      var caption = (asset.filename || '') + (multi ? '  ·  ' + (lbState.idx + 1) + ' / ' + lbState.frames.length : '');
      var ts = (asset.frame_timestamps || [])[lbState.idx];
      if (typeof ts === 'number'){
        var mm = Math.floor(ts / 60); var ss = (ts - mm * 60).toFixed(2);
        caption += '  ·  @ ' + (mm < 10 ? '0' + mm : mm) + ':' + (parseFloat(ss) < 10 ? '0' + ss : ss);
      }
      lbCaption.textContent = caption;
    }
  }

  function openLightboxFrames(frames, idx, asset){
    lbState = { mode: 'image', frames: frames || [], idx: idx || 0, asset: asset || null };
    renderLightbox();
    lb.classList.add('open');
  }

  function openLightboxVideo(path, caption){
    lbState = { mode: 'video', videoPath: path, caption: caption || '', frames: [], idx: 0, asset: null };
    renderLightbox();
    lb.classList.add('open');
  }

  function closeLightbox(){
    lb.classList.remove('open');
    lbContent.innerHTML = '';
    lbToolbar.innerHTML = '';
    lbCaption.textContent = '';
  }

  lbClose.addEventListener('click', closeLightbox);
  lb.addEventListener('click', function(e){ if (e.target === lb) closeLightbox(); });
  lbPrev.addEventListener('click', function(e){
    e.stopPropagation();
    if (lbState.mode !== 'image' || lbState.frames.length < 2) return;
    lbState.idx = (lbState.idx - 1 + lbState.frames.length) % lbState.frames.length;
    renderLightbox();
  });
  lbNext.addEventListener('click', function(e){
    e.stopPropagation();
    if (lbState.mode !== 'image' || lbState.frames.length < 2) return;
    lbState.idx = (lbState.idx + 1) % lbState.frames.length;
    renderLightbox();
  });
  document.addEventListener('keydown', function(e){
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    else if (e.key === 'ArrowLeft') lbPrev.click();
    else if (e.key === 'ArrowRight') lbNext.click();
  });

  // bind clicks on row thumbnails (skip drawer toggle) and on group-card thumbs
  rows.forEach(function(r){
    var aid = r.getAttribute('data-asset-id');
    var asset = assetsById[aid] || {};
    var imgs = r.querySelectorAll('td.thumb-cell img');
    imgs.forEach(function(img, i){
      img.classList.add('no-drawer');
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', function(e){
        e.stopPropagation();
        var frames = asset.frame_paths && asset.frame_paths.length ? asset.frame_paths : [decodeURIComponent((img.src || '').replace(/^file:\/\//, ''))];
        openLightboxFrames(frames, Math.min(i, frames.length - 1), asset);
      });
    });
  });
  document.querySelectorAll('.members li').forEach(function(li){
    var aid = li.getAttribute('data-asset-id');
    var asset = assetsById[aid] || {};
    var img = li.querySelector('img.group-thumb');
    if (img){
      img.addEventListener('click', function(e){
        e.stopPropagation();
        var frames = asset.frame_paths && asset.frame_paths.length ? asset.frame_paths : [decodeURIComponent((img.src || '').replace(/^file:\/\//, ''))];
        openLightboxFrames(frames, 0, asset);
      });
    }
  });

  applyFilters();
})();
</script>
</body>
</html>
